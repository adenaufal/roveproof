# Model access is subscription-only through `codex login`.
# Do not set OPENAI_API_KEY, CODEX_API_KEY, or CODEX_ACCESS_TOKEN; preflight rejects non-ChatGPT auth.
# Codex credentials stay in Codex's credential store and must never be copied into this repository.

# Control mutations are loopback-only by default. Set an exact origin only behind an explicitly trusted proxy.
# ROVEPROOF_CONTROL_ORIGIN=https://roveproof.internal.example

# Reserved explicit provenance mode for later milestones.
ROVEPROOF_MODE=real
